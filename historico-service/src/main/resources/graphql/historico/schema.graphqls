scalar DateTime

type ConsultaHistorico {
    id: ID!
    pacienteUsername: String!
    medicoUsername: String!
    enfermeiroUsername: String
    dataHora: DateTime!
    observacoes: String
    status: String!
    ultimaAtualizacaoEm: DateTime
}

type Query {
    historicoPaciente(pacienteUsername: String!, somenteFuturas: Boolean): [ConsultaHistorico!]!
}
