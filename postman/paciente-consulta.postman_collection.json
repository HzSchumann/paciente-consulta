{
  "info": {
    "name": "Paciente Consulta - Tech Challenge Fase 3",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Criar consulta (médico)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Basic bWVkaWNvMToxMjM0NTY="
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "http://localhost:8080/consultas",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["consultas"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"pacienteUsername\": \"paciente1\",\n  \"medicoUsername\": \"medico1\",\n  \"enfermeiroUsername\": \"enfermeiro1\",\n  \"dataHora\": \"2030-01-10T14:00:00\",\n  \"observacoes\": \"Retorno\"\n}"
        }
      }
    },
    {
      "name": "Atualizar consulta (enfermeiro)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "Basic ZW5mZXJtZWlybzE6MTIzNDU2"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "http://localhost:8080/consultas/1",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["consultas", "1"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"observacoes\": \"Consulta remarcada\",\n  \"dataHora\": \"2030-01-10T15:00:00\"\n}"
        }
      }
    },
    {
      "name": "Minhas consultas (paciente)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Basic cGFjaWVudGUxOjEyMzQ1Ng=="
          }
        ],
        "url": {
          "raw": "http://localhost:8080/consultas/minhas?somenteFuturas=true",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["consultas", "minhas"],
          "query": [
            {
              "key": "somenteFuturas",
              "value": "true"
            }
          ]
        }
      }
    },
    {
      "name": "GraphQL histórico (paciente)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Basic cGFjaWVudGUxOjEyMzQ1Ng=="
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "http://localhost:8080/graphql",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["graphql"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"query\": \"query { historicoPaciente(pacienteUsername: \\\"paciente2\\\", somenteFuturas: true) { id pacienteUsername medicoUsername dataHora observacoes } }\"\n}"
        }
      }
    }
  ]
}
